---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Git Gif - Video to GIF Converter">
  <main class="container mx-auto px-4 py-8">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-2">Git Gif</h1>
      <p class="text-gray-400">Convert videos to GIFs optimized for GitHub</p>
    </header>

    <div class="max-w-2xl mx-auto">
      <div class="bg-gray-800 rounded-lg p-8 text-center">
        <p class="text-gray-300">Video converter coming soon...</p>
      </div>
    </div>
  </main>
</Layout>
